{
  "name": "mcp-cli-runner",
  "version": "1.0.0",
  "description": "Headless CLI test runner for MCP servers over stdio and SSE",
  "type": "module",
  "bin": {
    "mcp-cli": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test-notes": "tsx src/index.ts --command node --args ../../examples/01-sqlite-notes-server/dist/index.js list-tools"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.1.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
